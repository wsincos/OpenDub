FROM ghcr.io/astral-sh/uv:0.6.3 AS uv
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_NO_CACHE=1 \
    UV_LINK_MODE=copy

RUN apt-get update \
    && apt-get install --no-install-recommends -y ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 opendub \
    && useradd --uid 10001 --gid opendub --create-home --shell /usr/sbin/nologin opendub

COPY --from=uv /uv /uvx /bin/
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src ./src
RUN uv sync --frozen --no-dev
RUN mkdir /workspace && chown opendub:opendub /workspace

USER opendub
EXPOSE 8000
ENTRYPOINT ["uv", "run", "--no-sync", "opendub", "serve"]
CMD ["--workspace", "/workspace", "--host", "0.0.0.0", "--port", "8000"]
