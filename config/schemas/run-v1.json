{
  "additionalProperties": false,
  "description": "Reproducibility metadata captured for every generated candidate.",
  "properties": {
    "adapter_id": {
      "minLength": 1,
      "title": "Adapter Id",
      "type": "string"
    },
    "adapter_version": {
      "minLength": 1,
      "title": "Adapter Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "input_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "title": "Input Hashes",
      "type": "object"
    },
    "model_id": {
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "options": {
      "additionalProperties": true,
      "default": {},
      "title": "Options",
      "type": "object"
    },
    "project_id": {
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "default": "opendub.run/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "segment_id": {
      "minLength": 1,
      "title": "Segment Id",
      "type": "string"
    },
    "weights_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Weights Sha256",
      "type": "string"
    }
  },
  "required": [
    "id",
    "project_id",
    "segment_id",
    "adapter_id",
    "adapter_version",
    "model_id",
    "weights_sha256",
    "seed"
  ],
  "title": "RunManifest",
  "type": "object"
}
